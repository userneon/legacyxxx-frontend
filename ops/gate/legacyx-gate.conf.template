# Pre-launch gate (generated by ops/gate.sh). Include it INSIDE the legacyx.cc server block, above the
# line that includes legacyx-frontend.conf:
#
#   include /etc/nginx/snippets/legacyx-gate.conf;
#   include /etc/nginx/snippets/legacyx-frontend.conf;
#
# Everyone gets the static countdown page (nothing of the real site, no app bundle) unless they carry the
# preview cookie, or the file __GATE_DIR__/OPEN exists (ops/gate.sh off).

set $lx_gate 1;
if ($cookie_lx_preview = "__SECRET__") { set $lx_gate 0; }
if (-f __GATE_DIR__/OPEN) { set $lx_gate 0; }
if ($request_uri = "/__preview/__SECRET__") { set $lx_gate 0; }
# Steam sign-in is not part of the site: the Discord link flow and its callback pass through to the API even before launch.
if ($uri ~ ^/api/v1/auth/steam) { set $lx_gate 0; }

if ($lx_gate) { return 503; }
error_page 503 @lx_countdown;

# Open once to get the cookie, then browse the real site as usual.
location = /__preview/__SECRET__ {
    add_header Set-Cookie "lx_preview=__SECRET__; Path=/; Max-Age=2592000; Secure; HttpOnly; SameSite=Lax" always;
    add_header Cache-Control "no-store" always;
    return 302 /;
}

location @lx_countdown {
    root __GATE_DIR__;
    rewrite ^ /countdown.html break;
    add_header Cache-Control "no-store" always;
    add_header X-LX-Gate closed always;
    add_header Retry-After 3600 always;
    add_header X-Robots-Tag "noindex" always;
}
