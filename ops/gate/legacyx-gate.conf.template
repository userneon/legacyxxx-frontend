# Pre-launch gate (generated by ops/gate.sh). Include it INSIDE the legacyx.cc server block, above the
# line that includes legacyx-frontend.conf:
#
#   include /etc/nginx/snippets/legacyx-gate.conf;
#   include /etc/nginx/snippets/legacyx-frontend.conf;
#
# Everyone gets the Coming Soon site (nothing of the real site, no app bundle) unless they carry the
# preview cookie, or the file __GATE_DIR__/OPEN exists (ops/gate.sh off).

set $lx_gate 1;
if ($cookie_lx_preview = "__SECRET__") { set $lx_gate 0; }
if (-f __GATE_DIR__/OPEN) { set $lx_gate 0; }
if ($request_uri = "/__preview/__SECRET__") { set $lx_gate 0; }
# Steam sign-in is not part of the site: the Discord link flow and its callback pass through to the API even before launch.
if ($uri ~ ^/api/v1/auth/steam) { set $lx_gate 0; }

if ($lx_gate) { return 503; }
# 200, not 503: the Coming Soon page and the Terms and Privacy pages are real pages (App Store and TikTok review open them).
error_page 503 =200 @lx_countdown;

# Open once to get the cookie, then browse the real site as usual.
location = /__preview/__SECRET__ {
    add_header Set-Cookie "lx_preview=__SECRET__; Path=/; Max-Age=2592000; Secure; HttpOnly; SameSite=Lax" always;
    add_header Cache-Control "no-store" always;
    return 302 /;
}

# The Coming Soon site (npm run build:soon, published by ops/deploy.sh into __GATE_DIR__/soon): only that page, Terms and Privacy. A file that is not
# in it (any address of the real site, its /assets/ bundle) gets the page itself, so nothing of the real site is ever sent before the launch.
location @lx_countdown {
    root __GATE_DIR__/soon;
    charset utf-8;
    charset_types text/markdown text/xml text/plain application/javascript application/json;
    include /etc/nginx/mime.types;
    types { text/markdown md; }
    # A file of the Coming Soon site (or a folder with an index.html: /terms, /privacy) is served as it is; any other address gets the page itself (rewrite ... break stays in this
    # location, so the gate does not run a second time). A missing file under /assets/ is a plain 404.
    if (-f $request_filename) { break; }
    if (-f $request_filename/index.html) { rewrite ^(.*[^/])/?$ $1/index.html break; }
    if ($uri ~ ^/assets/) { return 404; }
    rewrite ^ /index.html break;
    add_header Cache-Control "no-cache" always;
    add_header X-LX-Gate closed always;
    add_header X-Robots-Tag "noindex" always;
}
